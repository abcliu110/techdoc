{
  "id": "whole-conjecture",
  "type": "conjecture",
  "name": "发现整体与部分规律",
  "instruction": "通过观察和思考，发现整体与部分的关系规律",
  "content": {
    "type": "conjecture",
    "observationPrompt": "观察整体与部分的分割，你能发现什么规律？",
