      ],
      "equalLength": true,
      "showLabels": true,
      "animatable": true
    },
    "interaction": {
      "type": "fill",
      "options": [
        { "id": "fill-1", "label": "大", "isCorrect": false },
        { "id": "fill-2", "label": "小", "isCorrect": true }
