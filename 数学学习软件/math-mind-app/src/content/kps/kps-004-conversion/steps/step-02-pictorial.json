      "type": "rectGrid",
      "rows": 10,
      "cols": 10,
      "filledCells": [],
      "showGrid": true,
      "animatable": true
    },
    "interaction": {
      "type": "tap",
      "options": [
        { "id": "tap-03", "label": "3/10 = 30/100 = 0.30", "isCorrect": true },
        { "id": "tap-003", "label": "3/10 = 3/100 = 0.03" },
        { "id": "tap-0030", "label": "3/10 = 300/100 = 3.00" }
      ]
    },
    "feedback": [
      {
        "type": "correct",
        "message": "正确！3/10 = 30/100 = 0.30（可以简写为0.3）。分子分母同时扩大或缩小相同的倍数，分数的值不变。",
        "animation": "bounce"
      },
      {
        "type": "incorrect",
        "message": "提示：把分母从10变成100，需要分子分母同时乘以10。3×10=？",
