      "type": "numberLine",
      "start": 0,
      "end": 25,
      "marks": [0, 5, 10, 15, 20],
      "points": [
        { "value": 12, "label": "12（部分）", "color": "#4A90D9" },
        { "value": 20, "label": "整体", "color": "#7B68EE" }
      ],
      "animatable": true
    },
    "interaction": {
      "type": "input",
      "placeholder": "请输入整体的值",
      "inputType": "number"
    },
    "feedback": [
      {
        "type": "correct",
        "message": "正确！12 ÷ 3/5 = 12 × 5/3 = 20。因为20的3/5等于12个单位。",
        "animation": "glow"
      },
      {
        "type": "incorrect",
        "message": "提示：12是整体的3/5，那么1/5是多少？整体有几个1/5？",
        "animation": "shake",
        "highlight": ["number-line"]
      }
    ],
    "autoAdvance": 2000
